# Copy to .env and fill in locally. Never commit .env.
# In AWS these values come from SSM Parameter Store (/lfw/firms_map_key, /lfw/admin_token).

# NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Admin token for draft / approve / review API calls (demo control, not production auth)
ADMIN_TOKEN=

# Store backend: local | dynamodb
STORE=

# Amazon Bedrock model id or inference profile id (never hard-coded)
BEDROCK_MODEL_ID=

# AWS region
AWS_REGION=
